
<div id="spotify-container" class="hidden" aria-hidden="true" inert transition:persist>
  <a 
    target="_blank" 
    rel="noopener noreferrer"
    class="group flex flex-col gap-0 px-2 py-2 border-t border-base-300 transition-all hover:bg-base-300/50 hover:rounded-xl"
    id="spotify-link-element"
  >
    <div class="flex items-center justify-between mb-1">
      <span class="text-[9px] uppercase tracking-[0.2em] font-bold opacity-40 leading-none">
        Now Playing
      </span>
      <svg 
        class="w-3 h-3 text-base-content opacity-20 group-hover:opacity-100 group-hover:text-primary transition-all duration-300"
        viewBox="0 0 24 24" 
        fill="currentColor"
      >
        <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.491 17.306c-.215.353-.671.463-1.025.249-2.813-1.718-6.353-2.107-10.521-1.153-.404.092-.808-.159-.9-.563-.092-.403.159-.808.563-.9 4.557-1.042 8.475-.603 11.614 1.312.353.214.464.671.249 1.025zm1.467-3.259c-.27.439-.844.582-1.283.312-3.219-1.977-8.126-2.551-11.933-1.396-.491.148-1.001-.133-1.149-.624-.148-.492.133-1.002.624-1.15 4.356-1.321 9.771-.676 13.449 1.581.439.27.583.844.312 1.283zm.126-3.411c-3.858-2.291-10.231-2.502-13.94-1.376-.591.18-1.214-.157-1.394-.748-.18-.591.157-1.214.748-1.394 4.254-1.291 11.291-1.043 15.72 1.586.532.316.704 1.004.388 1.536-.316.532-1.004.704-1.536.388z"/>
      </svg>
    </div>

    <div id="spotify-content"  class="flex items-center justify-between gap-3 min-w-0" >
        
      <img id="spotify-art" width="40" height="40" class="hidden w-10 h-10 rounded-md object-cover shadow-sm group-hover:shadow-md transition-shadow" alt="Album Cover"/>
        
      <div class="flex flex-col min-w-0 flex-1">  
        <span id="spotify-title" class="text-sm font-semibold text-base-content opacity-90 leading-tight group-hover:text-primary transition-all duration-300 mb-0.5 line-clamp-2"></span>
        <span id="spotify-artist" class="text-[11px] opacity-60 italic leading-tight line-clamp-1"></span>
      </div>

      <div class="spotify-equalizer text-primary" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>

    </div>
  </a>
</div>

<style>

  #spotify-container {
    transition: opacity 0.4s ease-in-out;
    opacity: 0;
    overflow: hidden;
    box-sizing: border-box;
    contain: layout;
  }

  #spotify-container.is-visible {
    opacity: 1;
  }
  
  /* Fade tra le canzoni */
  #spotify-content {
    opacity: 1;
    transition: opacity 0.4s ease-in-out;
  }

  #spotify-content.fade-out {
    opacity: 0;
  }

  #spotify-container.hidden {
    display: none; /* Tailwind lo gestisce già, ma per sicurezza */
  }

  .spotify-equalizer {
    display: flex;
    align-items: center;
    gap: 2px;
    width: 18px;
    height: 16px;
    flex-shrink: 0;
  }

  .spotify-equalizer > span {
    width: 3px;
    height: 14px;
    border-radius: 3px;
    background: currentColor;
    transform-origin: center;
    animation: spotify-equalizer 1.2s ease-in-out infinite;
  }

  .spotify-equalizer > span:nth-child(2) {
    animation-delay: -0.6s;
    animation-duration: 1s;
  }

  .spotify-equalizer > span:nth-child(3) {
    animation-delay: -0.2s;
    animation-duration: 1.4s;
  }

  .spotify-equalizer > span:nth-child(4) {
    animation-delay: -0.8s;
  }

  @keyframes spotify-equalizer {
    0%, 100% { transform: scaleY(0.35); }
    50% { transform: scaleY(1); }
  }

  #spotify-container:not(.is-visible) .spotify-equalizer > span {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    #spotify-container, #spotify-content {
      transition: none;
    }

    .spotify-equalizer > span {
      animation: none;
    }
  }

</style>

<script>
  import { createSpotifyWidget } from "../scripts/spotify.js";

  let activeContainer: HTMLElement | null = null;
  let cleanup: (() => void) | undefined;

  function syncSpotifyWidget() {
    const container = document.getElementById("spotify-container");
    if (container === activeContainer) return;

    cleanup?.();
    activeContainer = container;
    cleanup = container ? createSpotifyWidget(container) : undefined;
  }

  syncSpotifyWidget();
  document.addEventListener("astro:after-swap", syncSpotifyWidget);
</script>
